{
  "name": "opencityvoice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "typecheck": "next typegen && tsc --noEmit",
