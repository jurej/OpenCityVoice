  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
