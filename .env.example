# Public URL of the app (used in e-mails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (values for local development come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated OAuth providers enabled in Supabase Auth: google,facebook,apple,azure
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook
# Show e-mail + password sign-in (handy for demo accounts in development)
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false

# Map style (any MapLibre style URL). Default: OpenFreeMap Positron (free, no key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Outgoing e-mail via SMTP (any provider, e.g. Resend, Postmark, SES).
# Local Supabase ships Mailpit: smtp://127.0.0.1:54325, inbox at http://127.0.0.1:54324
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="TownPing <no-reply@townping.local>"
